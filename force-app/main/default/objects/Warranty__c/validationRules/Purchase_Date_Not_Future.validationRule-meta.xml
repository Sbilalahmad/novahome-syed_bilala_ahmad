<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Purchase_Date_Not_Future</fullName>
    <active>true</active>
    <errorConditionFormula><![CDATA[AND(NOT(ISBLANK(Purchase_Date__c)), Purchase_Date__c > TODAY())]]></errorConditionFormula>
    <errorMessage>Purchase Date cannot be in the future.</errorMessage>
</ValidationRule>
