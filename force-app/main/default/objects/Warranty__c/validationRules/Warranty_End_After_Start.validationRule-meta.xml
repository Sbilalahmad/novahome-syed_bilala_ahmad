<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Warranty_End_After_Start</fullName>
    <active>true</active>
    <errorConditionFormula><![CDATA[AND(NOT(ISBLANK(Warranty_Start_Date__c)), NOT(ISBLANK(Warranty_End_Date__c)), Warranty_End_Date__c <= Warranty_Start_Date__c)]]></errorConditionFormula>
    <errorMessage>Warranty End Date must be after Warranty Start Date.</errorMessage>
</ValidationRule>
