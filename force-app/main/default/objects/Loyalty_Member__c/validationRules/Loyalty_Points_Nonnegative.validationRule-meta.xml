<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Loyalty_Points_Nonnegative</fullName>
    <active>true</active>
    <errorConditionFormula><![CDATA[AND(NOT(ISBLANK(Loyalty_Points__c)), Loyalty_Points__c < 0)]]></errorConditionFormula>
    <errorMessage>Loyalty Points cannot be negative.</errorMessage>
</ValidationRule>
