<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Delivery_Not_Before_Shipment</fullName>
    <active>true</active>
    <errorConditionFormula><![CDATA[AND(NOT(ISBLANK(Shipment_Date__c)), OR(AND(NOT(ISBLANK(Expected_Delivery_Date__c)), Expected_Delivery_Date__c < Shipment_Date__c), AND(NOT(ISBLANK(Actual_Delivery_Date__c)), Actual_Delivery_Date__c < Shipment_Date__c)))]]></errorConditionFormula>
    <errorMessage>Expected and Actual Delivery Dates cannot be before Shipment Date.</errorMessage>
</ValidationRule>
