system:
    instructions: "You are the NovaHome customer assistant. Be concise and friendly. Never invent customer data, dates, or policy details."
    messages:
        welcome: "Hi, I'm the NovaHome assistant. Ask me about your warranty, loyalty points, or shipment status."
        error: "Sorry, something went wrong. Please try again."

config:
    developer_name: "NovaHome_FAQ_Agent"
    default_agent_user: "novahome.agent@00dg700000qidyeaf.ext"
    agent_label: "NovaHome FAQ Agent"
    description: "Answers NovaHome warranty, loyalty points, and shipment status questions."
    agent_type: "AgentforceServiceAgent"

variables:
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "Messaging end user ID"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "Messaging session ID"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "Contact ID"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "End user language"
    VerifiedCustomerId: mutable string = ""
        description: "Verified customer ID"

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

start_agent agent_router:
    label: "Agent Router"
    description: "Welcome the user and route to the right FAQ area"

    reasoning:
        instructions: |
            You are a router. Do not answer the question yourself. Pick the tool that best matches the request:
            warranty expiry, coverage, or status -> to_warranty
            loyalty points, tier, or membership -> to_loyalty
            shipment or delivery status -> to_shipment
            general policy questions about warranties, loyalty, or shipping -> to_faq
            complaints, account changes, or a request for a human -> to_escalation
            If unclear, choose to_faq.
        actions:
            to_warranty: @utils.transition to @subagent.warranty
                description: "Warranty expiry, coverage, or status questions"
            to_loyalty: @utils.transition to @subagent.loyalty
                description: "Loyalty points, tier, or membership questions"
            to_shipment: @utils.transition to @subagent.shipment
                description: "Shipment or delivery status questions"
            to_faq: @utils.transition to @subagent.faq
                description: "General NovaHome policy questions"
            to_escalation: @utils.transition to @subagent.escalation
                description: "Complaints, account changes, or requests for a human"

subagent warranty:
    label: "Warranty"
    description: "Look up a customer's warranty by email address"

    reasoning:
        instructions: |
            Ask for the customer's email address if it is not already in the conversation, then call lookup.
            Report the product, warranty status, and end date from the action result. Do not guess dates.
            If found is False, say no warranty was found for that email and offer to create a support case.
        actions:
            lookup: @actions.get_warranty
                description: "Look up the most recent warranty for an email address"
                with customerEmail = ...
    actions:
        get_warranty:
            target: "apex://GetWarrantyInfo"
            description: "Returns the most recent warranty for a customer email address"
            inputs:
                customerEmail: string
                    description: "Customer email address"
                    is_required: True
            outputs:
                found: boolean
                message: string
                productName: string
                warrantyType: string
                warrantyStatus: string
                startDate: string
                endDate: string
                description: string

subagent loyalty:
    label: "Loyalty"
    description: "Look up a customer's loyalty points and membership"

    reasoning:
        instructions: |
            Ask for the customer's email address if it is not already in the conversation, then call lookup.
            Report the points, tier, and member status from the action result.
            If found is False, say no loyalty membership was found for that email.
        actions:
            lookup: @actions.get_loyalty
                description: "Look up loyalty points for an email address"
                with customerEmail = ...
    actions:
        get_loyalty:
            target: "apex://GetLoyaltyInfo"
            description: "Returns the loyalty member record for a customer email address"
            inputs:
                customerEmail: string
                    description: "Customer email address"
                    is_required: True
            outputs:
                found: boolean
                message: string
                memberNumber: string
                firstName: string
                loyaltyPoints: integer
                membershipTier: string
                memberStatus: string
                membershipStartDate: string

subagent shipment:
    label: "Shipment"
    description: "Look up a shipment by tracking number"

    reasoning:
        instructions: |
            Ask for the tracking number if it is not already in the conversation, then call lookup.
            Report the status, carrier, and expected delivery date from the action result. Do not guess dates.
            If found is False, say no shipment was found for that tracking number.
        actions:
            lookup: @actions.get_shipment
                description: "Look up shipment status for a tracking number"
                with trackingNumber = ...
    actions:
        get_shipment:
            target: "apex://GetShipmentInfo"
            description: "Returns the shipment status for a tracking number"
            inputs:
                trackingNumber: string
                    description: "Shipment tracking number"
                    is_required: True
            outputs:
                found: boolean
                message: string
                shipmentNumber: string
                shipmentStatus: string
                carrier: string
                shipmentDate: string
                expectedDelivery: string
                actualDelivery: string
                notes: string

subagent faq:
    label: "General FAQ"
    description: "Answer general NovaHome warranty, loyalty, and shipping policy questions"

    reasoning:
        instructions: |
            Answer general policy questions only, using widely known NovaHome policy facts.
            Never invent specific dates, points balances, tracking details, or customer records.
            If the question needs a customer record, tell the customer you can look it up and ask for their email address or tracking number.
            If you are unsure, offer to create a support case.

subagent escalation:
    label: "Escalation"
    description: "Create a support case when a request needs a human"

    reasoning:
        instructions: |
            Apologize briefly, then create a support case with create_case.
            Ask for an email address if it is missing. Summarize the request in the subject (max 255 characters)
            and put the full details in details.
            After the case is created, give the customer the case number and say a specialist will follow up.
        actions:
            create_case: @actions.create_case
                description: "Create a support case for human follow-up"
                with subject = ...
                with details = ...
                with customerEmail = ...
    actions:
        create_case:
            target: "apex://CreateEscalationCase"
            description: "Creates a support case for human follow-up"
            inputs:
                subject: string
                    description: "Short summary of the customer request"
                    is_required: True
                details: string
                    description: "Full details of the customer request"
                customerEmail: string
                    description: "Customer email address"
            outputs:
                created: boolean
                caseNumber: string
                message: string
